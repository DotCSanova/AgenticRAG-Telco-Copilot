# ─── Cohere ───────────────────────────────────────────────────────────────────
# Used for embeddings and chat via LiteLLM.
# Get one at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-api-key

# ─── Chunking ─────────────────────────────────────────────────────────────────
# section | semantic  (Cloud Run ingest sets section)
CHUNKER=section
# Docling (optional; defaults 50 / 4 / 2)
# INGEST_PAGES_PER_SHARD=50
# INGEST_LAYOUT_BATCH_SIZE=4
# INGEST_TABLE_BATCH_SIZE=2
SEMANTIC_CHUNK_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_CHUNK_THRESHOLD=0.7
SEMANTIC_CHUNK_MIN_TOKENS=64
SEMANTIC_CHUNK_MAX_TOKENS=128

# ─── Qdrant ───────────────────────────────────────────────────────────────────
# Compose chat + agent-ingest always use http://qdrant:6333 (empty API key).
QDRANT_COLLECTION=tech_docs
QDRANT_ENABLE_SPARSE=true

# Cloud cluster: gcloud secrets + Cloud Run ingest. Not used by Docker Compose.
QDRANT_URL=https://xyz.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key

# Tests only (in-process Qdrant):
# QDRANT_IN_MEMORY=true

# ─── Retrieval + rerank ───────────────────────────────────────────────────────
RETRIEVAL_PREFETCH_LIMIT=30
RETRIEVAL_CANDIDATE_LIMIT=30
RERANK_TOP_N=10
RERANK_MODEL=rerank-v3.5

# Providers (composition root). Hoy: cohere / cohere / qdrant
DENSE_EMBEDDER=cohere
RERANKER_PROVIDER=cohere
VECTOR_STORE_PROVIDER=qdrant

# ─── Agent (ADK + LiteLLM / Cohere chat) ──────────────────────────────────────
AGENT_MODEL=cohere_chat/command-a-03-2025
AGENT_APP_NAME=rag_agent

# ─── GCP ──────────────────────────────────────────────────────────────────────
# gcloud ingest runbook + Cloud Run serving (later). Compose chat ignores this
# block and injects SESSIONS_DB_URL to the local `db` service (app:app).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
REGION=us-central1
USE_SECRET_MANAGER=false

# Cloud Run serving sessions: sessions.py builds
#   host=/cloudsql/$GOOGLE_CLOUD_PROJECT:$REGION:$INSTANCE_NAME
# Do not set CLOUDSQL_INSTANCE. DB_PASS stays a secret (SM / --set-secrets).
INSTANCE_NAME=agent-sessions
DB_USER=app
DB_PASS=(add a secure password here)
