# ─── Cohere ───────────────────────────────────────────────────────────────────
# Used for embeddings and chat via LiteLLM.
# Get one at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-api-key

# ─── Chunking ─────────────────────────────────────────────────────────────────
# section | semantic
CHUNKER=semantic
SEMANTIC_CHUNK_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_CHUNK_THRESHOLD=0.7
SEMANTIC_CHUNK_MIN_TOKENS=64
SEMANTIC_CHUNK_MAX_TOKENS=128

# ─── Qdrant ───────────────────────────────────────────────────────────────────
# URL of the Qdrant HTTP endpoint. Default if unset: http://localhost:6333
# Compose sets QDRANT_URL=http://qdrant:6333 (no API key).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tech_docs
# Colección hybrid-ready (dense + sparse). Pon false si solo quieres dense.
QDRANT_ENABLE_SPARSE=true

# Cloud: same URL field + API key (leave key unset for local).
# QDRANT_URL=https://xyz.gcp.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key

# Tests only (in-process Qdrant):
# QDRANT_IN_MEMORY=true

# ─── Retrieval + rerank ───────────────────────────────────────────────────────
RETRIEVAL_PREFETCH_LIMIT=30
RETRIEVAL_CANDIDATE_LIMIT=30
RERANK_TOP_N=10
RERANK_MODEL=rerank-v3.5

# Providers (composition root). Hoy: cohere / cohere / qdrant
DENSE_EMBEDDER=cohere
RERANKER_PROVIDER=cohere
VECTOR_STORE_PROVIDER=qdrant

# ─── Agent (ADK + LiteLLM / Cohere chat) ──────────────────────────────────────
AGENT_MODEL=cohere_chat/command-a-03-2025
AGENT_APP_NAME=rag_agent

# Dev UI (ADK web=True) — local:
#   uv run uvicorn RAG_Agent.infrastructure.agent.dev_ui:app --host 0.0.0.0 --port 8080
# Docker:
#   docker compose --profile dev up agent-dev-ui

# ─── Sessions (ADK DatabaseSessionService) ────────────────────────────────────
# Local / Compose: set the full SQLAlchemy URL (wins over Cloud SQL builder).
# SESSIONS_DB_URL=postgresql+asyncpg://app:app@localhost:5432/sessions
#
# Cloud Run: leave SESSIONS_DB_URL unset; set secrets/env:
# DB_USER=app
# DB_PASS=...          # from Secret Manager (--set-secrets)
# SESSIONS_DB_NAME=sessions
# CLOUDSQL_INSTANCE=project:region:instance
#
# If none of the above: falls back to InMemorySessionService.
