FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

COPY uv.lock pyproject.toml README.md ./
COPY src ./src

RUN uv sync --frozen --no-cache --no-dev --group serving

# Pre-download BM25 so Cloud Run / local serving never hit HuggingFace on cold start.
RUN uv run --no-sync python -c "from fastembed import SparseTextEmbedding; SparseTextEmbedding('Qdrant/bm25')"

ENV PATH="/app/.venv/bin:$PATH"

CMD ["fastapi", "run", "src/RAG_Agent/infrastructure/api/main_chat.py", "--port", "8080", "--host", "0.0.0.0"]
