FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Cloud Run Jobs / compose ingest: CPU torch (no NVIDIA in typical GCP Jobs).
ENV UV_TORCH_BACKEND=cpu

COPY uv.lock pyproject.toml README.md ./
COPY src ./src
COPY scripts ./scripts

RUN uv sync --frozen --no-cache --no-dev --no-default-groups --group ingest

# Hybrid indexing needs BM25 at runtime; bake it into the image layer.
RUN uv run --no-sync python -c "from fastembed import SparseTextEmbedding; SparseTextEmbedding('Qdrant/bm25')"

ENV PATH="/app/.venv/bin:$PATH"

# Override with: docker compose run --rm agent-ingest python scripts/ingest_local.py /data/doc.pdf
CMD ["python", "scripts/ingest_local.py", "--help"]
