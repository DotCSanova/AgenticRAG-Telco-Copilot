FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Cloud Run ingest Service / compose: CPU torch (no NVIDIA in typical GCP).
ENV UV_TORCH_BACKEND=cpu

COPY uv.lock pyproject.toml ./
COPY src ./src

# pyproject.toml declares readme = "README.md"; stub so uv sync works without shipping README.
RUN touch README.md

RUN uv sync --frozen --no-cache --no-dev --no-default-groups --group ingest

# Bake models into the image so Cloud Run does not hit HuggingFace at runtime (429 on shared IPs).
RUN uv run --no-sync python -c "from fastembed import SparseTextEmbedding; SparseTextEmbedding('Qdrant/bm25')"
# Docling layout + table structure (matches DoclingExtractor: do_ocr=False, do_table_structure=True).
RUN uv run --no-sync docling-tools models download -o /app/docling-models layout tableformer

ENV PATH="/app/.venv/bin:$PATH"
ENV DOCLING_ARTIFACTS_PATH=/app/docling-models

# Cloud Run Pub/Sub push worker. Override for local CLI:
#   docker compose run --rm agent-ingest python scripts/ingest_local.py /data/doc.pdf
CMD ["uvicorn", "RAG_Agent.infrastructure.api.main_ingest:app", "--host", "0.0.0.0", "--port", "8080", "--log-level", "info"]
